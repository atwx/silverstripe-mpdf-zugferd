{
    "name": "atwx/silverstripe-zugferd",
    "description": "Embed ZUGFeRD / Factur-X / XRechnung XML into PDFs (PDF/A-3) in Silverstripe; optional integration with atwx/silverstripe-mpdf",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "pdf",
        "zugferd",
        "xrechnung",
        "factur-x",
        "e-invoice",
        "mpdf"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "horstoeko/zugferd": "^1.0"
    },
    "require-dev": {
        "atwx/silverstripe-mpdf": "^1.0"
    },
    "suggest": {
        "atwx/silverstripe-mpdf": "Render templates with mPDF; the option 'zugferd' then embeds the e-invoice automatically"
    },
    "autoload": {
        "psr-4": {
            "Atwx\\Zugferd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atwx\\Zugferd\\Tests\\": "tests/php/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
