{
    "name": "atwx/silverstripe-mpdf-zugferd",
    "description": "Add-on for atwx/silverstripe-mpdf: embed ZUGFeRD / Factur-X / XRechnung XML into rendered PDFs (PDF/A-3)",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "pdf", "mpdf", "zugferd", "xrechnung", "factur-x", "e-invoice"],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "atwx/silverstripe-mpdf": "^1.0",
        "horstoeko/zugferd": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Atwx\\MpdfZugferd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atwx\\MpdfZugferd\\Tests\\": "tests/php/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
